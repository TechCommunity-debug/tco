---
import { t, type Locale } from '../i18n/ui';
import type { Crumb } from '../lib/seo';
import Icon from './Icon.astro';

interface Props {
  lang: Locale;
  crumbs: Crumb[];
}

const { lang, crumbs } = Astro.props;
---

<nav aria-label={t(lang, 'breadcrumb')} class="text-body-sm text-muted">
  <ol class="flex flex-wrap items-center gap-1">
    {
      crumbs.map((crumb, index) => {
        const current = index === crumbs.length - 1;
        return (
          <li class="flex items-center gap-1">
            {index > 0 && <Icon name="chevron-right" size={14} class="text-muted-soft" />}
            {current ? (
              <span aria-current="page" class="font-medium text-ink">
                {crumb.label}
              </span>
            ) : (
              <a href={crumb.href} class="hover:text-ink hover:underline">
                {crumb.label}
              </a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
