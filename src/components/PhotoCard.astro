---
import { Image } from 'astro:assets';
import { getLocalImage } from '../lib/images';

/* Photo-first card (DESIGN.md property-card / experience-card). Credits appear on the linked page and /sources/. */
interface Props {
  href: string;
  title: string;
  meta?: string;
  description?: string;
  image: { file: string; alt: string };
  aspect?: 'square' | 'portrait';
  headingLevel?: 'h2' | 'h3';
  priority?: boolean;
}

const { href, title, meta, description, image, aspect = 'square', headingLevel = 'h3', priority = false } = Astro.props;
const Heading = headingLevel;
---

<article class="group relative">
  <div class:list={['overflow-hidden rounded-md bg-surface-strong', aspect === 'square' ? 'aspect-square' : 'aspect-[4/5]']}>
    <Image
      src={getLocalImage(image.file)}
      alt={image.alt}
      widths={[320, 480, 640]}
      sizes="(min-width: 1128px) 280px, (min-width: 744px) 33vw, (min-width: 550px) 50vw, 100vw"
      loading={priority ? 'eager' : 'lazy'}
      class="size-full object-cover transition-transform duration-300 ease-out motion-safe:group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-3">
    <Heading class="text-title font-semibold text-ink">
      <a href={href} class="after:absolute after:inset-0 after:rounded-md focus-visible:outline-none">
        {title}
      </a>
    </Heading>
    {meta && <p class="mt-1 text-body-sm text-muted">{meta}</p>}
    {description && <p class="mt-1 line-clamp-2 text-body-sm text-ink-body">{description}</p>}
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }
</style>
