---
import { Image } from 'astro:assets';
import { t, type Locale } from '../i18n/ui';
import { getCredit, getLocalImage } from '../lib/images';

/* A locally hosted image with its credit line from the image log. */
interface Props {
  file: string;
  alt: string;
  lang: Locale;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
  imgClass?: string;
}

const { file, alt, lang, sizes, widths = [480, 800, 1200, 1600], priority = false, class: className, imgClass } = Astro.props;
const image = getLocalImage(file);
const credit = await getCredit(file);
const usableWidths = widths.filter((w) => w <= image.width);
---

<figure class={className}>
  <Image
    src={image}
    alt={alt}
    widths={usableWidths.length ? usableWidths : [image.width]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={imgClass}
  />
  <figcaption class="mt-2 text-caption text-muted">
    {t(lang, 'imageCredit')}: <a href={credit.source_url} class="underline decoration-hairline underline-offset-2 hover:decoration-muted" rel="noopener">{credit.author}, {credit.source}</a>{' · '}<a href={credit.license_url} class="underline decoration-hairline underline-offset-2 hover:decoration-muted" rel="license noopener">{credit.license}</a>
  </figcaption>
</figure>
