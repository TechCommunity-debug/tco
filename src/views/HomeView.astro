---
import Icon from '../components/Icon.astro';
import PhotoCard from '../components/PhotoCard.astro';
import SearchPill from '../components/SearchPill.astro';
import { continentKeys, continents, segments, t, type ContinentKey } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { countryPath, garmentPath, getCountries, getGarments, localePath, pathFor, type SiteRoute } from '../lib/routes';

interface Props {
  route: SiteRoute;
}

const { route } = Astro.props;
const { lang } = route;
const [countries, garments] = await Promise.all([getCountries(lang), getGarments(lang)]);
const garmentNames = new Map(garments.map((g) => [g.id.split('/')[1], g.data.name]));
const countriesHref = localePath(lang, segments[lang].countries);
const garmentsHref = localePath(lang, segments[lang].garments);

const continentIcons: Record<ContinentKey, 'sun' | 'pagoda' | 'castle' | 'cactus' | 'mountain'> = {
  africa: 'sun',
  asia: 'pagoda',
  europe: 'castle',
  'north-america': 'cactus',
  'south-america': 'mountain',
};
const usedContinents = continentKeys.filter((key) => countries.some((c) => c.data.continent === key));

const searchOptions = [
  ...countries.map((c) => ({ name: c.data.name, href: countryPath(c), kind: t(lang, 'countries') })),
  ...garments.map((g) => ({ name: g.data.name, href: garmentPath(g), kind: t(lang, 'garments') })),
];

const site = Astro.site!;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t(lang, 'siteName'),
    url: new URL(route.path, site).href,
    inLanguage: lang,
  },
];
---

<BaseLayout route={route} description={t(lang, 'siteTagline')} jsonLd={jsonLd}>
  <section class="page-container pt-10 pb-8 text-center md:pt-16 md:pb-12">
    <h1 class="mx-auto max-w-2xl text-display-xl font-bold text-balance text-ink md:text-[32px]">{t(lang, 'heroTitle')}</h1>
    <p class="mx-auto mt-3 max-w-xl text-body text-pretty text-muted">{t(lang, 'heroLead')}</p>
    <div class="mt-8">
      <SearchPill lang={lang} fallbackHref={countriesHref} options={searchOptions} />
    </div>
  </section>

  <nav aria-label={t(lang, 'browseByContinent')} class="border-y border-hairline-soft">
    <ul class="page-container flex gap-8 overflow-x-auto py-4 [scrollbar-width:none] md:justify-center md:gap-12">
      {
        usedContinents.map((key) => (
          <li class="shrink-0">
            <a
              href={`${countriesHref}#${continents[key].anchor[lang]}`}
              class="flex flex-col items-center gap-2 border-b-2 border-transparent pb-2 text-body-sm font-medium text-muted transition-colors hover:border-hairline hover:text-ink"
            >
              <Icon name={continentIcons[key]} size={24} />
              {continents[key][lang]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="page-container py-12 md:py-16" aria-labelledby="home-countries">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 id="home-countries" class="text-display-lg font-semibold text-ink">{t(lang, 'featuredCountries')}</h2>
        <p class="mt-1 text-body-sm text-muted">{t(lang, 'featuredCountriesLead')}</p>
      </div>
      <a href={countriesHref} class="flex shrink-0 items-center gap-1 text-body-sm font-semibold text-ink underline underline-offset-4">
        {t(lang, 'viewAll')}<Icon name="chevron-right" size={16} />
      </a>
    </div>
    <ul class="mt-6 grid gap-x-4 gap-y-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        countries.map((country, index) => (
          <li>
            <PhotoCard
              href={countryPath(country)}
              title={country.data.name}
              meta={[continents[country.data.continent][lang], ...country.data.garments.map((g) => garmentNames.get(g))].filter(Boolean).join(' · ')}
              image={country.data.hero}
              priority={index < 4}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-container pb-12 md:pb-16" aria-labelledby="home-garments">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 id="home-garments" class="text-display-lg font-semibold text-ink">{t(lang, 'featuredGarments')}</h2>
        <p class="mt-1 text-body-sm text-muted">{t(lang, 'featuredGarmentsLead')}</p>
      </div>
      <a href={garmentsHref} class="flex shrink-0 items-center gap-1 text-body-sm font-semibold text-ink underline underline-offset-4">
        {t(lang, 'viewAll')}<Icon name="chevron-right" size={16} />
      </a>
    </div>
    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
      {
        garments.map((garment) => (
          <li>
            <PhotoCard href={garmentPath(garment)} title={garment.data.name} description={garment.data.summary} image={garment.data.hero} aspect="portrait" />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-container" aria-labelledby="home-trust">
    <div class="rounded-lg bg-surface-soft px-6 py-10 md:px-12 md:py-12">
      <h2 id="home-trust" class="text-display-sm font-semibold text-ink">{t(lang, 'howWeWork')}</h2>
      <p class="mt-3 max-w-3xl text-body text-ink-body">{t(lang, 'howWeWorkBody')}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={await pathFor('page:about', lang)} class="inline-flex h-12 items-center rounded-sm bg-ink px-6 text-body font-medium text-white hover:bg-black">
          {t(lang, 'readAbout')}
        </a>
        <a
          href={await pathFor('page:sources', lang)}
          class="inline-flex h-12 items-center rounded-sm border border-ink bg-canvas px-6 text-body font-medium text-ink hover:bg-surface-strong"
        >
          {t(lang, 'readSources')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
