---
import Icon from '../components/Icon.astro';
import PhotoCard from '../components/PhotoCard.astro';
import ExploreMoreCard from '../components/ExploreMoreCard.astro';
import SearchPill from '../components/SearchPill.astro';
import FaqSection, { type FaqItem } from '../components/FaqSection.astro';
import { faqJsonLd } from '../lib/seo';
import { continentKeys, continents, segments, t, type ContinentKey } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { countryPath, garmentPath, getCountries, getGarments, localePath, pathFor, type SiteRoute } from '../lib/routes';

interface Props {
  route: SiteRoute;
}

const { route } = Astro.props;
const { lang } = route;
const [countries, garments] = await Promise.all([getCountries(lang), getGarments(lang)]);
const garmentNames = new Map(garments.map((g) => [g.id.split('/')[1], g.data.name]));
const countryMap = new Map(countries.map((c) => [c.id.split('/')[1], countryPath(c)]));
const garmentMap = new Map(garments.map((g) => [g.id.split('/')[1], garmentPath(g)]));
const countriesHref = localePath(lang, segments[lang].countries);
const garmentsHref = localePath(lang, segments[lang].garments);
const featuredCountries = countries.length > 7 ? countries.slice(0, 7) : countries;
const featuredGarments = garments.length > 7 ? garments.slice(0, 7) : garments;

const continentIcons: Record<ContinentKey, 'sun' | 'pagoda' | 'castle' | 'cactus' | 'mountain'> = {
  africa: 'sun',
  asia: 'pagoda',
  europe: 'castle',
  'north-america': 'cactus',
  'south-america': 'mountain',
};
const usedContinents = continentKeys.filter((key) => countries.some((c) => c.data.continent === key));

const searchOptions = [
  ...countries.map((c) => ({ name: c.data.name, href: countryPath(c), kind: t(lang, 'countries') })),
  ...garments.map((g) => ({ name: g.data.name, href: garmentPath(g), kind: t(lang, 'garments') })),
];

const site = Astro.site!;
const faqItems: FaqItem[] =
  lang === 'de'
    ? [
        {
          question: 'Was gilt als traditionelle Kleidung?',
          answerHtml:
            '<p>Als <strong>traditionelle Kleidung</strong> (auch Tracht, Volkstracht oder Festgewand) bezeichnet man Gewänder, Textilien und Ensembles, die über Generationen hinweg innerhalb einer bestimmten Kultur, Volksgruppe oder Region entstanden sind. Sie zeichnet sich durch tiefe symbolische Bedeutung, die Darstellung von sozialem oder ehelichem Status sowie die Anpassung an regionale Klimabedingungen und Naturfasern aus. Typisch sind überlieferte Handwerkstechniken wie Weben, Sticken und natürliches Färben.</p>',
        },
        {
          question: 'Welche Länder haben traditionelle Trachten?',
          answerHtml: `<p>Praktisch jedes Land und jede Kultur der Welt besitzt traditionelle Trachten oder charakteristische Festgewänder. Zu den weltweit bekanntesten Beispielen zählen der japanische <a href="${garmentMap.get('kimono')}">Kimono</a>, der südkoreanische <a href="${garmentMap.get('hanbok')}">Hanbok</a>, der indische <a href="${garmentMap.get('sari')}">Sari</a>, das deutsche <a href="${garmentMap.get('dirndl')}">Dirndl</a> und die Lederhose, das nigerianische <a href="${garmentMap.get('agbada')}">Agbada</a>, der peruanische <a href="${garmentMap.get('poncho')}">Poncho</a>, der mexikanische <a href="${garmentMap.get('sarape')}">Sarape</a> sowie das chinesische <a href="${garmentMap.get('qipao')}">Qipao</a>. Viele Staaten beherbergen zudem zahlreiche regionale Trachtenvarianten.</p>`,
        },
        {
          question: 'Was ist der Unterschied zwischen traditioneller Kleidung und einer Nationaltracht?',
          answerHtml:
            '<p>Während <strong>traditionelle Kleidung</strong> das breite historische Spektrum an regionaler Alltags-, Arbeits- und Festtagskleidung verschiedener Gemeinschaften umfasst, bezeichnet eine <strong>Nationaltracht</strong> meist ein offiziell stilisiertes oder repräsentatives Gewand, das ausgewählt wurde, um die kulturelle Identität eines gesamten Staates bei internationalen Anlässen, Staatsakten oder Kulturfestivals zu repräsentieren.</p>',
        },
        {
          question: 'Warum wird traditionelle Kleidung auch heute noch getragen?',
          answerHtml:
            '<p>Traditionelle Kleidung wird getragen, um das kulturelle Erbe und familiäre Wurzeln zu ehren, bedeutende Lebensereignisse (wie Hochzeiten, religiöse Feiertage und Reifezeremonien) zu begehen und regionale Identität in einer globalisierten Welt auszudrücken. Zudem bewahrt das Tragen von Trachten wertvolles Handwerkswissen und inspiriert moderne nachhaltige Mode durch abfallfreie Schnittmuster.</p>',
        },
        {
          question: 'Wie beeinflussen Geografie und Klima traditionelle Gewänder?',
          answerHtml: `<p>Klima und regionale Naturressourcen haben Schnitt und Material traditioneller Kleidung maßgeblich geprägt. In kalten Gebirgsregionen wie den Anden oder Alpen schützen dichte Schaf- und Alpakawolle sowie robustes Leder vor der Kälte – wie beim peruanischen <a href="${garmentMap.get('poncho')}">Poncho</a> und der Alpen-Lederhose. In warmen, feuchten Zonen entstanden atmungsaktive Wickelgewänder und weite Schnitte aus Baumwolle und Seide – wie der indische <a href="${garmentMap.get('sari')}">Sari</a>, das nigerianische <a href="${garmentMap.get('agbada')}">Agbada</a> oder der japanische Yukata.</p>`,
        },
        {
          question: 'Was zeichnet traditionelle Hochzeitskleidung aus?',
          answerHtml:
            '<p>Traditionelle Hochzeitskleidung gehört zu den aufwendigsten und symbolträchtigsten Formen kultureller Kleidung weltweit. Sie zeichnet sich durch glücksbringende Farben und kostbare Stickereien aus: von scharlachroter Banarasi-Seide mit Goldfäden bei indischen Bräuten über feierliche Aso-Ebi-Spitze mit farblich abgestimmtem Gele in Nigeria bis hin zur weißen Shiromuku-Seidenrobe in Japan und dem Zeremonial-Hanbok in Korea.</p>',
        },
      ]
    : [
        {
          question: 'What is considered traditional clothing?',
          answerHtml:
            '<p><strong>Traditional clothing</strong> refers to garments, ensembles, textiles, and accessories that have evolved within a specific culture, community, ethnic group, or geographic region over generations. Unlike fast-moving modern fashion cycles, traditional clothing is deeply rooted in local heritage, social customs, religious practices, marital status, and adaptations to regional climate. Hallmarks include distinctive silhouettes, handloom weaving, elaborate embroidery, and the use of natural fibers like silk, wool, linen, and cotton.</p>',
        },
        {
          question: 'Which country has traditional dress?',
          answerHtml: `<p>Nearly every country and culture in the world has traditional dress or regional folk costumes. Iconic examples featured in our directory include Japan (<a href="${garmentMap.get('kimono')}">Kimono</a>), South Korea (<a href="${garmentMap.get('hanbok')}">Hanbok</a>), India (<a href="${garmentMap.get('sari')}">Sari</a>), Germany (<a href="${garmentMap.get('dirndl')}">Dirndl</a> and Lederhosen), Nigeria (<a href="${garmentMap.get('agbada')}">Agbada</a>), Peru (<a href="${garmentMap.get('poncho')}">Poncho</a>), Mexico (<a href="${garmentMap.get('sarape')}">Sarape</a>), and China (<a href="${garmentMap.get('qipao')}">Qipao</a>). Many nations also feature dozens of regional variations reflecting distinct ethnic provinces and historical eras.</p>`,
        },
        {
          question: 'What is the difference between traditional clothing and a national costume?',
          answerHtml:
            '<p>While <strong>traditional clothing</strong> encompasses the wide variety of everyday, seasonal, and ceremonial garments developed organically by distinct ethnic or regional communities over centuries, a <strong>national costume</strong> is often an officially recognized or widely popularized ensemble selected to symbolize the collective identity of an entire nation on the global stage, such as in diplomatic gatherings, cultural pageants, or international ceremonies.</p>',
        },
        {
          question: 'Why do people still wear traditional clothing today?',
          answerHtml:
            '<p>People continue wearing traditional clothing to honor ancestral roots, mark significant life milestones (such as weddings, religious festivals, and coming-of-age ceremonies), and express cultural pride in an interconnected world. In addition, traditional garments preserve master artisanal craftsmanship, sustain local handloom economies, and inspire contemporary sustainable fashion with zero-waste pattern drafting.</p>',
        },
        {
          question: 'How does climate and geography shape traditional attire?',
          answerHtml: `<p>Geography and local natural materials fundamentally shape traditional garment construction. Cold, mountainous regions developed insulating garments made of sheep or alpaca wool and durable leather—such as Andean <a href="${garmentMap.get('poncho')}">ponchos</a> and Alpine lederhosen. Tropical and humid climates favored breathable, unstitched drapes and lightweight silks or cottons—such as Indian <a href="${garmentMap.get('sari')}">saris</a>, Nigerian <a href="${garmentMap.get('agbada')}">agbadas</a>, and Japanese summer yukatas.</p>`,
        },
        {
          question: 'What is traditional wedding attire?',
          answerHtml:
            '<p>Traditional wedding attire encompasses ceremonial garments, veils, headwraps, and jewelry worn during marriage rites according to cultural customs. It often showcases the highest degree of textile artistry and symbolic color—such as scarlet Banarasi silk and gold zari for Indian brides, royal blue aso-ebi and matching gele headties in Nigeria, white and pastel ceremonial hanbok in South Korea, and elegant shiromuku silk robes in Japan.</p>',
        },
      ];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: t(lang, 'siteName'),
    alternateName: ['Traditional Clothing Hub', 'Traditional Clothing Guide'],
    url: new URL(route.path, site).href,
    inLanguage: lang,
    description: t(lang, 'homeMetaDescription'),
    potentialAction: {
      '@type': 'SearchAction',
      target: `${new URL(countriesHref, site).href}#{search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: t(lang, 'siteName'),
    url: site.href,
    logo: new URL('/favicon.svg', site).href,
    description: t(lang, 'homeMetaDescription'),
  },
  faqJsonLd(
    faqItems.map((item) => ({
      question: item.question,
      answerHtml: item.answerHtml.replace(/href="([^"]+)"/g, (_, p) => `href="${new URL(p, site).href}"`),
    }))
  ),
];
---

<BaseLayout route={route} description={t(lang, 'homeMetaDescription')} keywords={t(lang, 'homeMetaKeywords')} jsonLd={jsonLd}>
  <section class="page-container pt-10 pb-8 text-center md:pt-16 md:pb-12">
    <h1 class="mx-auto max-w-2xl text-display-xl font-bold text-balance text-ink md:text-[32px]">{t(lang, 'heroTitle')}</h1>
    <p class="mx-auto mt-3 max-w-xl text-body text-pretty text-muted">{t(lang, 'heroLead')}</p>
    <div class="mt-8">
      <SearchPill lang={lang} fallbackHref={countriesHref} options={searchOptions} />
    </div>
  </section>

  <nav aria-label={t(lang, 'browseByContinent')} class="border-y border-hairline-soft">
    <ul class="page-container flex gap-8 overflow-x-auto py-4 [scrollbar-width:none] md:justify-center md:gap-12">
      {
        usedContinents.map((key) => (
          <li class="shrink-0">
            <a
              href={`${countriesHref}#${continents[key].anchor[lang]}`}
              class="flex flex-col items-center gap-2 border-b-2 border-transparent pb-2 text-body-sm font-medium text-muted transition-colors hover:border-hairline hover:text-ink"
            >
              <Icon name={continentIcons[key]} size={24} />
              {continents[key][lang]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section class="page-container py-12 md:py-16" aria-labelledby="home-countries">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 id="home-countries" class="text-display-lg font-semibold text-ink">{t(lang, 'featuredCountries')}</h2>
        <p class="mt-1 text-body-sm text-muted">{t(lang, 'featuredCountriesLead')}</p>
      </div>
      <a href={countriesHref} class="flex shrink-0 items-center gap-1 text-body-sm font-semibold text-ink underline underline-offset-4">
        {t(lang, 'viewAll')}<Icon name="chevron-right" size={16} />
      </a>
    </div>
    <ul class="mt-6 grid gap-x-4 gap-y-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        featuredCountries.map((country, index) => (
          <li>
            <PhotoCard
              href={countryPath(country)}
              title={country.data.name}
              meta={[continents[country.data.continent][lang], ...country.data.garments.map((g) => garmentNames.get(g))].filter(Boolean).join(' · ')}
              image={country.data.hero}
              priority={index < 4}
            />
          </li>
        ))
      }
      <li>
        <ExploreMoreCard
          href={countriesHref}
          title={t(lang, 'exploreMoreCountries')}
          subtitle={t(lang, 'exploreMoreCountriesLead')}
          actionText={t(lang, 'viewAllCountries')}
          aspect="square"
        />
      </li>
    </ul>
  </section>

  <section class="page-container pb-12 md:py-16" aria-labelledby="home-garments">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 id="home-garments" class="text-display-lg font-semibold text-ink">{t(lang, 'featuredGarments')}</h2>
        <p class="mt-1 text-body-sm text-muted">{t(lang, 'featuredGarmentsLead')}</p>
      </div>
      <a href={garmentsHref} class="flex shrink-0 items-center gap-1 text-body-sm font-semibold text-ink underline underline-offset-4">
        {t(lang, 'viewAll')}<Icon name="chevron-right" size={16} />
      </a>
    </div>
    <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
      {
        featuredGarments.map((garment) => (
          <li>
            <PhotoCard href={garmentPath(garment)} title={garment.data.name} description={garment.data.summary} image={garment.data.hero} aspect="portrait" />
          </li>
        ))
      }
      <li>
        <ExploreMoreCard
          href={garmentsHref}
          title={t(lang, 'exploreMoreGarments')}
          subtitle={t(lang, 'exploreMoreGarmentsLead')}
          actionText={t(lang, 'viewAllGarments')}
          aspect="portrait"
        />
      </li>
    </ul>
  </section>

  {/* Comprehensive 600+ Word Editorial Guide & Educational SEO Section */}
  <section class="page-container py-12 md:py-16 border-t border-hairline" aria-labelledby="home-guide">
    <header class="max-w-3xl">
      <span class="inline-block rounded-full bg-surface-strong px-3 py-1 text-caption font-semibold uppercase tracking-wider text-muted">
        {t(lang, 'homeGuideBadge')}
      </span>
      <h2 id="home-guide" class="mt-3 text-display-xl font-bold text-ink md:text-[30px] leading-tight">
        {t(lang, 'homeGuideTitle')}
      </h2>
      <p class="mt-3 text-body text-muted">
        {t(lang, 'homeGuideLead')}
      </p>
    </header>

    {
      lang === 'de' ? (
        <div class="mt-10 space-y-10">
          <div class="rounded-xl border border-hairline-soft bg-surface-soft p-6 md:p-8">
            <h3 class="text-display-sm font-semibold text-ink">
              Das Verzeichnis für weltweite traditionelle Kleidung und Kulturgewänder
            </h3>
            <p class="mt-3 text-body text-ink-body leading-relaxed">
              <strong>Traditional Clothing Hub</strong> ist ein frei zugängliches digitales Referenzwerkzeug und ein interaktives Verzeichnis zur Erforschung und Dokumentation authentischer <strong>traditioneller Kleidung</strong> weltweit. Von festlichen Bräuchen bis hin zum lebendigen Alltagskulturerbe bietet unser Archiv fundierte historische Recherchen, detaillierte Analysen zur Schnittführung und geprüfte Bilddokumente aus führenden Museen der Welt. Ob Lehrkräfte, Textilforschende, Modeschaffende oder Kulturinteressierte: Dieses digitale Werkzeug ermöglicht eine intuitive und lehrreiche Entdeckungsreise durch das faszinierende textile Erbe der Menschheit rund um den Globus.
            </p>
          </div>

          <div class="rounded-xl border border-hairline bg-canvas p-6 md:p-8">
            <h3 class="text-display-sm font-semibold text-ink">
              Traditionelle Kleidung nach Land: Kontinente, Regionen und lebendige Identität
            </h3>
            <p class="mt-3 text-body text-ink-body leading-relaxed">
              Unser Online-Verzeichnis erfasst <strong>traditionelle Kleidung nach Land</strong> und ordnet das weltweite textile Erbe übersichtlich nach Kontinenten: Afrika, Asien, Europa, Nordamerika und Südamerika. Jede Tracht und jedes traditionelle Kleidungsstück erzählt eine eigene kulturgeschichtliche Geschichte, die von regionaler Geografie, lokal verfügbaren Naturfasern, klimatischen Bedingungen und historischen Handelswegen geprägt wurde. In Asien entdecken Sie weltbekannte Ikonen wie den japanischen Seidenkimono (<a href={garmentMap.get('kimono')} class="underline font-medium text-ink hover:text-primary">Kimono in Japan</a>), das figurbetonte chinesische <a href={garmentMap.get('qipao')} class="underline font-medium text-ink hover:text-primary">Qipao</a> und den edlen koreanischen <a href={garmentMap.get('hanbok')} class="underline font-medium text-ink hover:text-primary">Hanbok</a> in <a href={countryMap.get('south-korea')} class="underline font-medium text-ink hover:text-primary">Südkorea</a>. In Südasien begeistert der indische <a href={garmentMap.get('sari')} class="underline font-medium text-ink hover:text-primary">Sari</a> mit jahrhundertealter Webkunst und unnachahmlichen Farbwelten. In Europa veranschaulicht der mitteleuropäische Alpenraum mit bayerischem <a href={garmentMap.get('dirndl')} class="underline font-medium text-ink hover:text-primary">Dirndl</a> und rustikalen Lederhosen in <a href={countryMap.get('germany')} class="underline font-medium text-ink hover:text-primary">Deutschland</a> die lebendige Trachtentradition. In Westafrika zeugt die nigerianische <a href={garmentMap.get('agbada')} class="underline font-medium text-ink hover:text-primary">Agbada</a>-Robe in <a href={countryMap.get('nigeria')} class="underline font-medium text-ink hover:text-primary">Nigeria</a> von handwerklicher Meisterschaft und königlicher Würde, während in Südamerika farbenfroh gewebte <a href={garmentMap.get('poncho')} class="underline font-medium text-ink hover:text-primary">Ponchos</a> in <a href={countryMap.get('peru')} class="underline font-medium text-ink hover:text-primary">Peru</a> und kunstvoll verzierte <a href={garmentMap.get('sarape')} class="underline font-medium text-ink hover:text-primary">Sarapes</a> in <a href={countryMap.get('mexico')} class="underline font-medium text-ink hover:text-primary">Mexiko</a> das indigene Kunsthandwerk lebendig halten.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            <div class="rounded-xl border border-hairline-soft bg-surface-soft p-6 md:p-8">
              <h3 class="text-display-sm font-semibold text-ink">
                Traditionelle Kleidung für Männer: Würde, Struktur und Funktion
              </h3>
              <p class="mt-3 text-body text-ink-body leading-relaxed">
                In den verschiedenen Weltkulturen spiegelt <strong>traditionelle Kleidung für Männer</strong> gesellschaftliche Rollen, Würde, handwerkliche Funktion und Familienabstammung wider. In Nigeria ist die <a href={garmentMap.get('agbada')} class="underline font-medium text-ink hover:text-primary">Agbada</a> ein dreiteiliges Prachtgewand mit weiten, fließenden Schulterbahnen, das bei Hochzeiten, Krönungen und festlichen Empfängen getragen wird und Autorität ausstrahlt. In Ostasien kombiniert der traditionelle <a href={garmentMap.get('hanbok')} class="underline font-medium text-ink hover:text-primary">Hanbok</a> für Männer weite Baji-Hosen mit einer strukturierten Jeogori-Jacke, während japanische Männer dezente Seidenkimonos oder luftige Yukata mit einem stabilen Kaku-Obi binden. Im europäischen Alpenraum zeichnen sich Lederhosen für Männer durch sämisch gegerbtes Hirschleder, Hornknöpfe, kunstvoll bestickte Hosenträger und jahrzehntelange Haltbarkeit für alpine Bedingungen aus. In Mexiko dient der dichte wollene <a href={garmentMap.get('sarape')} class="underline font-medium text-ink hover:text-primary">Sarape</a> seit Generationen als wetterfester Umhang und Reitermantel der Charros. Unser Online-Guide beleuchtet Schnittmuster, Schulterdrapierungen, Stoffqualitäten und Trageregeln für traditionelle Männerkleidung weltweit im Detail.
              </p>
            </div>

            <div class="rounded-xl border border-hairline-soft bg-surface-soft p-6 md:p-8">
              <h3 class="text-display-sm font-semibold text-ink">
                Traditionelle Kleidung für Frauen: Kunstvolle Drapierung und Symbolik
              </h3>
              <p class="mt-3 text-body text-ink-body leading-relaxed">
                Ebenso faszinierend ist die <strong>traditionelle Kleidung für Frauen</strong>, die sich durch unübertroffene textile Finesse, symbolträchtige Farbwahl und kunstvolle Drapiertechniken auszeichnet. In Indien besteht der <a href={garmentMap.get('sari')} class="underline font-medium text-ink hover:text-primary">Sari</a> aus fünf bis neun Metern ungeschnittener Seide oder feinster Baumwolle, getragen mit einer passgenauen Choli-Bluse und Unterrock, verziert mit traditionellen Pfauen- und Paisley-Motiven. In Japan reicht das Spektrum der Frauenkleidung vom prachtvollen, langärmeligen Furisode-<a href={garmentMap.get('kimono')} class="underline font-medium text-ink hover:text-primary">Kimono</a> für unverheiratete Frauen bis zum eleganten schwarzen Tomesode mit goldenen Familienwappen für feierliche Anlässe. In China revolutionierte das hochgeschlossene <a href={garmentMap.get('qipao')} class="underline font-medium text-ink hover:text-primary">Qipao</a> im Shanghai der 1920er Jahre die feminine Silhouette mit Stehkragen und kunstvollen Posamentenverschlüssen. In Bayern und Österreich vereint das <a href={garmentMap.get('dirndl')} class="underline font-medium text-ink hover:text-primary">Dirndl</a> figurbetontes Mieder, schwingenden Rock und weiße Schürze – wobei die Schleife der Schürze traditionell den Beziehungsstatus der Trägerin verrät. In den peruanischen Anden tragen indigene Frauen mehrlagige, leuchtend bestickte Polleras und mit natürlichen Cochenille-Farben gefärbte Wolltücher (Lliclla).
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-hairline bg-canvas p-6 md:p-8">
            <h3 class="text-display-sm font-semibold text-ink">
              Trachten, Volkstrachten und lebendiges Weltkulturerbe
            </h3>
            <p class="mt-3 text-body text-ink-body leading-relaxed">
              <strong>Trachten, Volkstrachten und traditionelle Gewänder</strong> sind keineswegs verstaubte Relikte der Vergangenheit, sondern lebendige Zeugnisse kultureller Identität. Zu feierlichen Höhepunkten entfaltet <strong>traditionelle Hochzeitskleidung</strong> ihre volle Strahlkraft: Bei nigerianischen Hochzeiten kleidet sich das Brautpaar in abgestimmte königsblaue Aso-Ebi-Spitze, während indische Bräute in scharlachroter Banarasi-Seide mit goldenen Zari-Stickereien erstrahlen. Bei regionalen Festen wie dem Münchner Oktoberfest, dem traditionellen Gion Matsuri in Kyoto oder dem koreanischen Chuseok-Fest tragen Generationen ihre Festtagstracht mit Stolz. Zudem lassen sich moderne Modeschaffende und Designer von den abfallfreien Schnitttechniken traditionsreicher Gewänder für zeitgenössische nachhaltige Mode inspirieren.
            </p>
          </div>

          <div class="rounded-xl border border-hairline-soft bg-surface-soft p-6 md:p-8">
            <h3 class="text-display-sm font-semibold text-ink">
              So nutzen Sie den Traditional Clothing Hub
            </h3>
            <p class="mt-3 text-body text-ink-body leading-relaxed">
