---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { continentKeys, continents, t } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import { countryPath, getCountries, getGarments, localePath, type SiteRoute } from '../lib/routes';
import { breadcrumbJsonLd, type Crumb } from '../lib/seo';

interface Props {
  route: SiteRoute;
}

const { route } = Astro.props;
const { lang } = route;
const [countries, garments] = await Promise.all([getCountries(lang), getGarments(lang)]);
const garmentNames = new Map(garments.map((g) => [g.id.split('/')[1], g.data.name]));

const groups = continentKeys
  .map((key) => ({ key, countries: countries.filter((c) => c.data.continent === key) }))
  .filter((group) => group.countries.length > 0);

const crumbs: Crumb[] = [
  { label: t(lang, 'home'), href: localePath(lang) },
  { label: t(lang, 'countries'), href: route.path },
];
---

<BaseLayout route={route} title={t(lang, 'countriesTitle')} description={t(lang, 'countriesDescription')} jsonLd={[breadcrumbJsonLd(crumbs, Astro.site!)]}>
  <div class="page-container pt-6">
    <Breadcrumbs lang={lang} crumbs={crumbs} />
    <header class="mt-6 max-w-3xl">
      <h1 class="text-display-xl font-bold text-ink md:text-[32px]">{t(lang, 'countriesTitle')}</h1>
      <p class="mt-3 text-body text-muted">{t(lang, 'countriesLead')}</p>
    </header>

    <nav aria-label={t(lang, 'browseByContinent')} class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {
          groups.map((group) => (
            <li>
              <a
                href={`#${continents[group.key].anchor[lang]}`}
                class="inline-flex h-10 items-center gap-2 rounded-full border border-hairline px-4 text-body-sm font-medium text-ink transition-colors hover:border-ink"
              >
                {continents[group.key][lang]}
                <span class="text-muted">{group.countries.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((group) => (
        <section class="mt-12 border-t border-hairline pt-10" aria-labelledby={continents[group.key].anchor[lang]}>
          <h2 id={continents[group.key].anchor[lang]} class="text-display-lg font-semibold text-ink">
            {continents[group.key][lang]}
          </h2>
          <p class="mt-1 text-body-sm text-muted">
            {group.countries.length === 1 ? t(lang, 'countryCountOne') : t(lang, 'countryCount', { n: group.countries.length })}
          </p>
          <ul class="mt-6 grid gap-x-4 gap-y-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {group.countries.map((country) => (
              <li>
                <PhotoCard
                  href={countryPath(country)}
                  title={country.data.name}
                  meta={country.data.garments.map((g) => garmentNames.get(g)).filter(Boolean).join(' · ')}
                  image={country.data.hero}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
