---
import ErrorLayout from '../../layouts/ErrorLayout.astro';
import Icon from '../../components/Icon.astro';
import { t, segments } from '../../i18n/ui';
import { localePath, getCountries, countryPath } from '../../lib/routes';

const countries = await getCountries('de');
const featuredCountryIds = ['japan', 'india', 'nigeria', 'mexico', 'germany', 'south-korea'];
const featured = countries
  .filter((c) => featuredCountryIds.includes(c.id.replace('de/', '')))
  .map((c) => ({ name: c.data.name, path: countryPath(c) }));
---

<ErrorLayout
  statusCode="404"
  lang="de"
  title="404: Seite nicht gefunden | Traditional Clothing Hub"
  description="Die angeforderte Seite konnte nicht gefunden werden. Entdecken Sie traditionelle Kleidung, Trachten und kulturelles Textilerbe aus aller Welt."
>
  <div class="page-container flex flex-col items-center justify-center py-12 md:py-20">
    <div class="w-full max-w-2xl rounded-lg border border-hairline bg-surface-soft/40 p-6 md:p-10 text-center dark:border-hairline dark:bg-surface-soft/60">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary-soft px-4 py-1.5 text-body-sm font-bold text-primary dark:border-primary/30">
        <Icon name="compass" size={18} />
        <span>Fehler 404 • Seite nicht gefunden</span>
      </div>

      <h1 class="mt-5 text-display-xl font-bold tracking-tight text-ink sm:text-[36px]">
        {t('de', 'notFoundTitle')}
      </h1>

      <p class="mt-3 text-body font-medium text-ink-body">
        {t('de', 'notFoundBody')}
      </p>

      <p class="mt-2 text-body-sm text-muted">
        {t('de', 'notFoundHint')}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={localePath('de')}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-sm bg-primary px-6 text-body font-medium text-white transition-colors hover:bg-primary-active focus-visible:outline-none"
        >
          <Icon name="home" size={18} />
          <span>{t('de', 'backHome')}</span>
        </a>
        <a
          href={localePath('de', segments.de.countries)}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-sm border border-hairline bg-canvas px-5 text-body font-medium text-ink transition-all hover:border-ink hover:shadow-float dark:border-border-strong"
        >
          <Icon name="globe" size={18} />
          <span>{t('de', 'exploreCountriesBtn')}</span>
        </a>
        <a
          href={localePath('de', segments.de.garments)}
          class="inline-flex h-12 items-center justify-center gap-2 rounded-sm border border-hairline bg-canvas px-5 text-body font-medium text-ink transition-all hover:border-ink hover:shadow-float dark:border-border-strong"
        >
          <Icon name="hanger" size={18} />
          <span>{t('de', 'exploreGarmentsBtn')}</span>
        </a>
      </div>

      <!-- Quick Discovery Links -->
      <div class="mt-10 border-t border-hairline-soft pt-6 text-left sm:text-center">
        <p class="text-caption font-semibold text-muted uppercase tracking-wider">
          {t('de', 'popularDestinations')}
        </p>
        <div class="mt-3 flex flex-wrap justify-center gap-2">
          {
            featured.map((item) => (
              <a
                href={item.path}
                class="rounded-sm border border-hairline bg-canvas px-3.5 py-1.5 text-body-sm font-medium text-ink transition-colors hover:border-primary hover:text-primary dark:border-border-strong"
              >
                {item.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</ErrorLayout>
