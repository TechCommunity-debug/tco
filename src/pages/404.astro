---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { locales, t } from '../i18n/ui';
import { localePath } from '../lib/routes';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t('en', 'notFoundTitle')} | Traditional Clothing Hub</title>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="TraditionalC" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <header class="border-b border-hairline">
      <div class="page-container flex h-20 items-center">
        <Logo href="/" />
      </div>
    </header>
    <main class="page-container grid gap-12 py-16 md:grid-cols-2">
      {
        locales.map((lang) => (
          <section lang={lang}>
            <p class="text-body-sm font-semibold text-primary">404</p>
            <h1 class="mt-2 text-display-xl font-bold text-ink">{t(lang, 'notFoundTitle')}</h1>
            <p class="mt-3 text-body text-muted">{t(lang, 'notFoundBody')}</p>
            <a href={localePath(lang)} class="mt-6 inline-flex h-12 items-center rounded-sm bg-primary px-6 text-body font-medium text-white hover:bg-primary-active">
              {t(lang, 'backHome')}
            </a>
          </section>
        ))
      }
    </main>
  </body>
</html>
